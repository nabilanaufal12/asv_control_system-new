Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Cell Size: 1
      Plane Cell Count: 50
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Axes: true
      Show Names: true
      Frame: odom
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic: /odom/raw
      Value: true
      Keep: 100
      Color: 0; 255; 255
    - Class: rviz_default_plugins/PointCloud2
      Name: ObstaclePointCloud
      Topic: /perception/obstacle_points
      Value: true
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Image
      Name: CameraView
      Topic: /perception/image_annotated
      Value: true
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 3.14
