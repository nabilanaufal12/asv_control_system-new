<?xml version="1.0" ?>
<!-- ==============================================================================
  kki_arena_course.world — REVISED v2.0
  Official KKI 2026 Closed-Loop Competition Arena (Lintasan A)
  ASV Navantara — Tim UMRAH, Kontes Kapal Cepat Tak Berawak Indonesia 2026
  Venue: Waduk PDAM Kota Bengkalis, Riau.
  ──────────────────────────────────────────────────────────────────────────
  Arena Grid: 5x5 (Kolom A–E, Baris 1–5), Skala: 1 grid = 5 meter
  Sumbu koordinat: X = Timur (+X), Y = Utara (+Y), Origin = Dermaga START (E,Row1)
  ──────────────────────────────────────────────────────────────────────────
  Lintasan A (Counter-Clockwise):
    START(0,0) → Utara: Gate 1–3 (Kolom E) →
    Belok Kiri → Barat: Gate 4–7 (Baris 5) →
    Belok Kiri → Selatan: Gate 8–10 (Kolom A) →
    Misi Surface Imaging (Kotak Hijau) →
    Misi Underwater Imaging (Kotak Biru) →
    DOCKING (3 Bola Biru, Dermaga FINISH)
  ──────────────────────────────────────────────────────────────────────────
  Spesifikasi Resmi Panduan KKI 2026 (Pasal 4.4.2–4.4.4):
  • 10 pasang bola merah–hijau (20 bola total), celah gerbang = 2.0 meter
  • Misi Surface Imaging: Kotak Hijau (Cat Pylox PB110)
  • Misi Underwater Imaging: Kotak Biru (Cat Pylox PB107)
  • Docking: 3 bola biru berjajar, jarak antartitik tengah = 30 cm
  • Penalti: -5 poin per tabrakan; >5 pelanggaran → Run diulang
============================================================================== -->
<sdf version="1.6">
  <world name="kki_arena_lintasan_a">

    <!-- ===================================================================== -->
    <!-- PHYSICS: ODE 500 Hz — Smooth Marine Vessel Hydrodynamics              -->
    <!-- ===================================================================== -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type><iters>50</iters><sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Sun & Sky -->
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.72 0.88 0.95 1.0</background>
      <shadows>true</shadows>
      <sky><clouds><speed>8</speed></clouds></sky>
    </scene>

    <!-- ===================================================================== -->
    <!-- WATER SURFACE: Waduk PDAM Bengkalis (80m x 40m effective basin)       -->
    <!-- ===================================================================== -->
    <model name="water_surface">
      <static>true</static>
      <pose>12.5 12.5 0.0 0 0 0</pose>
      <link name="link">
        <visual name="water_visual">
          <geometry><plane><normal>0 0 1</normal><size>85.0 45.0</size></plane></geometry>
          <material>
            <ambient>0.04 0.22 0.42 0.88</ambient>
            <diffuse>0.06 0.32 0.62 0.88</diffuse>
            <specular>0.65 0.72 0.80 1.0</specular>
          </material>
        </visual>
        <collision name="water_col">
          <geometry><plane><normal>0 0 1</normal><size>85.0 45.0</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- ARENA BOUNDARY WALL (Simple invisible collision walls)                 -->
    <!-- ===================================================================== -->
    <!-- North wall (y=25) -->
    <model name="wall_north"><static>true</static><pose>12.5 25.0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>85 0.2 1.0</size></box></geometry></collision></link>
    </model>
    <!-- South wall (y=0) -->
    <model name="wall_south"><static>true</static><pose>12.5 0.0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>85 0.2 1.0</size></box></geometry></collision></link>
    </model>

    <!-- ===================================================================== -->
    <!-- START / FINISH DOCK (Origin: x=0, y=0, facing North / +Y direction)   -->
    <!-- Corresponds to Grid E-Row1 in KKI Panduan Gambar 3                    -->
    <!-- ===================================================================== -->
    <model name="start_finish_dock">
      <static>true</static>
      <pose>0.0 -1.5 0.08 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>3.5 2.0 0.16</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1.0</ambient><diffuse>0.55 0.35 0.18 1.0</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>3.5 2.0 0.16</size></box></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- DOCKING TARGET: 3 Blue Balls (30cm apart, at y=-0.5 to y=0.5)         -->
    <!-- Rule: Sentuh 1 bola = 5 pts, 2 bola = 10 pts, 3 bola = 15 pts         -->
    <!-- ===================================================================== -->
    <model name="dock_ball_blue_1">
      <static>true</static><pose>0.0 -0.30 0.12 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.05 0.15 0.90 1.0</ambient><diffuse>0.05 0.20 0.95 1.0</diffuse><specular>0.5 0.5 0.5 1.0</specular></material>
        </visual>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
      </link>
    </model>
    <model name="dock_ball_blue_2">
      <static>true</static><pose>0.0 0.0 0.12 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.05 0.15 0.90 1.0</ambient><diffuse>0.05 0.20 0.95 1.0</diffuse><specular>0.5 0.5 0.5 1.0</specular></material>
        </visual>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
      </link>
    </model>
    <model name="dock_ball_blue_3">
      <static>true</static><pose>0.0 0.30 0.12 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.05 0.15 0.90 1.0</ambient><diffuse>0.05 0.20 0.95 1.0</diffuse><specular>0.5 0.5 0.5 1.0</specular></material>
        </visual>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- LINTASAN A: LEG 1 — UTARA (Kolom E / Sisi Kanan)                   -->
    <!-- Kapal melaju ke +Y (Utara). Red = Kiri (+X), Green = Kanan (-X)    -->
    <!-- Gate 1–3, spacing ~5m, buoy offset ±1.0m dari center               -->
    <!-- ================================================================== -->
    <!-- Gate 1 — y=5.0 -->
    <model name="leg1_g1_red"><static>true</static><pose>1.0 5.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><ambient>0.85 0.05 0.05 1.0</ambient><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg1_g1_green"><static>true</static><pose>-1.0 5.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><ambient>0.05 0.85 0.05 1.0</ambient><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- Gate 2 — y=10.0 -->
    <model name="leg1_g2_red"><static>true</static><pose>1.0 10.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg1_g2_green"><static>true</static><pose>-1.0 10.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- Gate 3 — y=15.0 (Puncak Lintasan, menjelang tikungan kiri) -->
    <model name="leg1_g3_red"><static>true</static><pose>1.0 15.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg1_g3_green"><static>true</static><pose>-1.0 15.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- ================================================================== -->
    <!-- CORNER TURN MARKER (Tikungan 1: Kanan ke Barat / -X direction)     -->
    <!-- ================================================================== -->
    <model name="turn1_marker_red"><static>true</static><pose>1.0 18.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual></link>
    </model>
    <model name="turn1_marker_green"><static>true</static><pose>-1.0 18.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual></link>
    </model>

    <!-- ================================================================== -->
    <!-- LINTASAN A: LEG 2 — BARAT (Baris 5 / Row Atas)                     -->
    <!-- Kapal melaju ke -X (Barat). Red = Kiri (+Y=Luar), Green = Kanan    -->
    <!-- Gate 4–7                                                            -->
    <!-- ================================================================== -->
    <!-- Gate 4 — x=-5.0, y=18~20 -->
    <model name="leg2_g4_red"><static>true</static><pose>-5.0 19.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg2_g4_green"><static>true</static><pose>-5.0 17.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- Gate 5 — x=-12.0 -->
    <model name="leg2_g5_red"><static>true</static><pose>-12.0 19.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg2_g5_green"><static>true</static><pose>-12.0 17.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- Gate 6 — x=-19.0 -->
    <model name="leg2_g6_red"><static>true</static><pose>-19.0 19.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg2_g6_green"><static>true</static><pose>-19.0 17.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- Gate 7 — x=-26.0 -->
    <model name="leg2_g7_red"><static>true</static><pose>-26.0 19.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg2_g7_green"><static>true</static><pose>-26.0 17.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- ================================================================== -->
    <!-- CORNER TURN MARKER (Tikungan 2: Kiri ke Selatan / -Y direction)    -->
    <!-- ================================================================== -->
    <model name="turn2_marker_red"><static>true</static><pose>-28.0 19.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual></link>
    </model>
    <model name="turn2_marker_green"><static>true</static><pose>-28.0 17.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual></link>
    </model>

    <!-- ================================================================== -->
    <!-- LINTASAN A: LEG 3 — SELATAN (Kolom A / Sisi Kiri)                  -->
    <!-- Kapal melaju ke -Y (Selatan). Red = Kiri (-X), Green = Kanan (+X)  -->
    <!-- Gate 8–10                                                           -->
    <!-- ================================================================== -->
    <!-- Gate 8 — y=14.0 -->
    <model name="leg3_g8_red"><static>true</static><pose>-29.0 14.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg3_g8_green"><static>true</static><pose>-27.0 14.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- Gate 9 — y=9.0 -->
    <model name="leg3_g9_red"><static>true</static><pose>-29.0 9.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg3_g9_green"><static>true</static><pose>-27.0 9.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- Gate 10 — y=4.0 (Gerbang terakhir sebelum zona misi) -->
    <model name="leg3_g10_red"><static>true</static><pose>-29.0 4.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.95 0.03 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>
    <model name="leg3_g10_green"><static>true</static><pose>-27.0 4.0 0.18 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.03 0.95 0.03 1.0</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision></link>
    </model>

    <!-- ================================================================== -->
    <!-- MISI 4: SURFACE IMAGING — Kotak Hijau (Cat Pylox PB110)             -->
    <!-- Posisi: Di leg horizontal menuju FINISH, setelah belok ke kanan    -->
    <!-- ================================================================== -->
    <model name="mission_surface_green_box">
      <static>true</static>
      <pose>-20.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.60 0.60 0.50</size></box></geometry>
          <material>
            <ambient>0.05 0.75 0.05 1.0</ambient>
            <diffuse>0.03 0.90 0.03 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.60 0.60 0.50</size></box></geometry></collision>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- MISI 5: UNDERWATER IMAGING — Kotak Biru (Cat Pylox PB107)           -->
    <!-- Di bawah permukaan air (z negatif), posisi kamera bawah air        -->
    <!-- ================================================================== -->
    <model name="mission_underwater_blue_box">
      <static>true</static>
      <pose>-10.0 1.5 -0.30 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.60 0.60 0.50</size></box></geometry>
          <material>
            <ambient>0.05 0.15 0.88 1.0</ambient>
            <diffuse>0.03 0.18 0.95 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.60 0.60 0.50</size></box></geometry></collision>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- PELAMPUNG TEPI / BATAS ARENA (Kuning — Hanya Visual, Tidak Diskor) -->
    <!-- ================================================================== -->
    <model name="boundary_1"><static>true</static><pose>5.0 22.0 0.08 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>0.14</radius><length>0.18</length></cylinder></geometry>
        <material><diffuse>0.95 0.75 0.05 1.0</diffuse></material></visual></link>
    </model>
    <model name="boundary_2"><static>true</static><pose>-10.0 22.0 0.08 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>0.14</radius><length>0.18</length></cylinder></geometry>
        <material><diffuse>0.95 0.75 0.05 1.0</diffuse></material></visual></link>
    </model>
    <model name="boundary_3"><static>true</static><pose>-25.0 22.0 0.08 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>0.14</radius><length>0.18</length></cylinder></geometry>
        <material><diffuse>0.95 0.75 0.05 1.0</diffuse></material></visual></link>
    </model>
    <model name="boundary_4"><static>true</static><pose>5.0 -2.0 0.08 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>0.14</radius><length>0.18</length></cylinder></geometry>
        <material><diffuse>0.95 0.75 0.05 1.0</diffuse></material></visual></link>
    </model>
    <model name="boundary_5"><static>true</static><pose>-15.0 -2.0 0.08 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>0.14</radius><length>0.18</length></cylinder></geometry>
        <material><diffuse>0.95 0.75 0.05 1.0</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
