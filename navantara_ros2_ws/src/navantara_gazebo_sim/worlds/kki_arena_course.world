<?xml version="1.0" ?>
<!-- ==============================================================================
  kki_arena_course.world
  Official Competition Arena Simulation World for ASV Navantara (UMRAH)
  Kontes Kapal Cepat Tak Berawak Indonesia (KKI) - Divisi Otonom (Autonomous ASV)
  SDF Version: 1.6 / 1.7 (Compatible with Gazebo Classic 11 & Gazebo Sim / Harmonic)
============================================================================== -->
<sdf version="1.6">
  <world name="kki_arena_course">

    <!-- Physics Engine Configuration (ODE 500 Hz Solver for Marine Hydrodynamics) -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Global Sun Illumination -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Atmospheric Skybox & Lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.7 0.85 0.95 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- ===================================================================== -->
    <!-- 1. WATER SURFACE PLANE (100m x 40m Marine Basin)                     -->
    <!-- ===================================================================== -->
    <model name="water_surface">
      <static>true</static>
      <pose>35.0 0.0 0.0 0 0 0</pose>
      <link name="link">
        <visual name="water_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>110.0 45.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.25 0.45 0.85</ambient>
            <diffuse>0.08 0.35 0.65 0.85</diffuse>
            <specular>0.6 0.7 0.8 1.0</specular>
          </material>
        </visual>
        <collision name="water_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>110.0 45.0</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 2. START DOCKING ZONE (Pangkal Start Kapal di x=0, y=0)                -->
    <!-- ===================================================================== -->
    <model name="start_dock">
      <static>true</static>
      <pose>-2.5 0.0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>3.0 4.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.25 0.15 1.0</ambient>
            <diffuse>0.5 0.35 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.0 4.0 0.2</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 3. KKI CORRIDOR GATE 1 (x = 8.0m, Width = 4.4m, Straight Approach)    -->
    <!-- ===================================================================== -->
    <!-- Gate 1: Red Buoy (Port / Kiri) -->
    <model name="gate1_buoy_red">
      <static>true</static>
      <pose>8.0 2.2 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.95 0.05 0.05 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- Gate 1: Green Buoy (Starboard / Kanan) -->
    <model name="gate1_buoy_green">
      <static>true</static>
      <pose>8.0 -2.2 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>0.1 0.8 0.1 1.0</ambient>
            <diffuse>0.05 0.95 0.05 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 4. KKI CORRIDOR GATE 2 (x = 18.0m, Width = 4.4m, S-Curve Port Shift)  -->
    <!-- ===================================================================== -->
    <model name="gate2_buoy_red">
      <static>true</static>
      <pose>18.0 3.4 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.95 0.05 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <model name="gate2_buoy_green">
      <static>true</static>
      <pose>18.0 -1.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.05 0.95 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 5. KKI OBSTACLE 1: Blue Box Obstacle in Corridor (x = 24.0m, y = +0.8m)-->
    <!-- ===================================================================== -->
    <model name="obstacle1_blue_box">
      <static>true</static>
      <pose>24.0 0.8 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.8 1.0</ambient>
            <diffuse>0.1 0.4 0.95 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
          </material>
        </visual>
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 6. KKI CORRIDOR GATE 3 (x = 30.0m, Width = 4.4m, Starboard Turn)      -->
    <!-- ===================================================================== -->
    <model name="gate3_buoy_red">
      <static>true</static>
      <pose>30.0 1.2 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.95 0.05 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <model name="gate3_buoy_green">
      <static>true</static>
      <pose>30.0 -3.2 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.05 0.95 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 7. KKI CORRIDOR GATE 4 (x = 42.0m, Width = 4.4m, Deep Right Curve)    -->
    <!-- ===================================================================== -->
    <model name="gate4_buoy_red">
      <static>true</static>
      <pose>42.0 0.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.95 0.05 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <model name="gate4_buoy_green">
      <static>true</static>
      <pose>42.0 -3.9 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.05 0.95 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 8. KKI OBSTACLE 2: Blue Ball Obstacle (x = 48.0m, y = -1.7m)          -->
    <!-- ===================================================================== -->
    <model name="obstacle2_blue_ball">
      <static>true</static>
      <pose>48.0 -1.7 0.20 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material>
            <ambient>0.1 0.25 0.8 1.0</ambient>
            <diffuse>0.1 0.35 0.95 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
          </material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 9. KKI CORRIDOR GATE 5 (x = 54.0m, Width = 4.4m, Straight Recovery)   -->
    <!-- ===================================================================== -->
    <model name="gate5_buoy_red">
      <static>true</static>
      <pose>54.0 2.2 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.95 0.05 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <model name="gate5_buoy_green">
      <static>true</static>
      <pose>54.0 -2.2 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.05 0.95 0.05 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 10. KKI FINISH GATE & DOCK (x = 66.0m, Width = 5.0m)                  -->
    <!-- ===================================================================== -->
    <!-- Finish Red Buoy with Tall Flag Pole -->
    <model name="finish_gate_red">
      <static>true</static>
      <pose>66.0 2.5 0.5 0 0 0</pose>
      <link name="link">
        <visual name="base_visual">
          <pose>0 0 -0.35 0 0 0</pose>
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><diffuse>0.95 0.05 0.05 1.0</diffuse></material>
        </visual>
        <visual name="pole_visual">
          <geometry><cylinder><radius>0.04</radius><length>1.0</length></cylinder></geometry>
          <material><diffuse>1.0 0.9 0.1 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Finish Green Buoy with Tall Flag Pole -->
    <model name="finish_gate_green">
      <static>true</static>
      <pose>66.0 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <visual name="base_visual">
          <pose>0 0 -0.35 0 0 0</pose>
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><diffuse>0.05 0.95 0.05 1.0</diffuse></material>
        </visual>
        <visual name="pole_visual">
          <geometry><cylinder><radius>0.04</radius><length>1.0</length></cylinder></geometry>
          <material><diffuse>1.0 0.9 0.1 1.0</diffuse></material>
        </visual>
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Finish Floating Pontoon / Platform (x = 70.0m) -->
    <model name="finish_dock">
      <static>true</static>
      <pose>71.0 0.0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 6.0 0.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1.0</ambient>
            <diffuse>0.9 0.9 0.9 1.0</diffuse>
          </material>
        </visual>
        <collision name="col"><geometry><box><size>4.0 6.0 0.2</size></box></geometry></collision>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 11. ARENA PERIMETER BUOYS (Outer Safety Boundary Lane)                -->
    <!-- ===================================================================== -->
    <!-- Left Boundary (+Y = 15m) -->
    <model name="boundary_left_1"><static>true</static><pose>15.0 15.0 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry><material><diffuse>0.9 0.6 0.1 1.0</diffuse></material></visual></link></model>
    <model name="boundary_left_2"><static>true</static><pose>35.0 15.0 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry><material><diffuse>0.9 0.6 0.1 1.0</diffuse></material></visual></link></model>
    <model name="boundary_left_3"><static>true</static><pose>55.0 15.0 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry><material><diffuse>0.9 0.6 0.1 1.0</diffuse></material></visual></link></model>

    <!-- Right Boundary (-Y = -15m) -->
    <model name="boundary_right_1"><static>true</static><pose>15.0 -15.0 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry><material><diffuse>0.9 0.6 0.1 1.0</diffuse></material></visual></link></model>
    <model name="boundary_right_2"><static>true</static><pose>35.0 -15.0 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry><material><diffuse>0.9 0.6 0.1 1.0</diffuse></material></visual></link></model>
    <model name="boundary_right_3"><static>true</static><pose>55.0 -15.0 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry><material><diffuse>0.9 0.6 0.1 1.0</diffuse></material></visual></link></model>

  </world>
</sdf>
