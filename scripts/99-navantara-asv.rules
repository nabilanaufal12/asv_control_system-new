# ==============================================================================
# 99-navantara-asv.rules
# Persistent USB Device Symlinks for ASV Navantara on NVIDIA Jetson Orin Nano
# ==============================================================================
# Installation:
#   sudo cp 99-navantara-asv.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# ==============================================================================

# 1. ESP32 Microcontroller (Actuator / Thruster / Rudder Serial Bridge) -> /dev/ttyASV
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ttyASV", MODE="0666", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="ttyASV", MODE="0666", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="ttyASV", MODE="0666", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", SYMLINK+="ttyASV", MODE="0666", GROUP="dialout"

# 2. u-blox ZED-F9P High-Precision RTK GNSS Receiver -> /dev/ttyGPS
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", SYMLINK+="ttyGPS", MODE="0666", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a8", SYMLINK+="ttyGPS", MODE="0666", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", SYMLINK+="ttyGPS", MODE="0666", GROUP="dialout"

# 3. Vision Cameras (Surface & Underwater)
# Surface Camera (Logitech C930c or serial B6CAA7AF) -> /dev/video_surface
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0891", ATTR{index}=="0", SYMLINK+="video_surface", MODE="0666", GROUP="video"
SUBSYSTEM=="video4linux", ATTRS{serial}=="B6CAA7AF", ATTR{index}=="0", SYMLINK+="video_surface", MODE="0666", GROUP="video"

# Underwater Camera -> /dev/video_underwater
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="32e6", ATTRS{idProduct}=="9221", ATTR{index}=="0", SYMLINK+="video_underwater", MODE="0666", GROUP="video"
SUBSYSTEM=="video4linux", ATTRS{serial}=="20201212000000", ATTR{index}=="0", SYMLINK+="video_underwater", MODE="0666", GROUP="video"
